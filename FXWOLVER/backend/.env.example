# FXWOLVER — Backend Environment Variables
# Copy this file to .env and fill in your values

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ─────────────────────────────────────────────────────
# Binance — Public API (No keys needed for market data)
# ─────────────────────────────────────────────────────
# BINANCE_API_KEY=optional_for_trading
# BINANCE_API_SECRET=optional_for_trading

# ─────────────────────────────────────────────────────
# OANDA Practice API — Phase 4 (Forex live prices)
# Get a free practice account at: https://www.oanda.com/
# ─────────────────────────────────────────────────────
# OANDA_API_KEY=your_practice_api_key_here
# OANDA_ACCOUNT_ID=your_account_id
# OANDA_API_URL=https://api-fxpractice.oanda.com

# ─────────────────────────────────────────────────────
# Alpaca Markets — Phase 5 (US Stocks)
# Free paper trading at: https://alpaca.markets/
# ─────────────────────────────────────────────────────
# ALPACA_API_KEY=your_api_key
# ALPACA_API_SECRET=your_api_secret
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─────────────────────────────────────────────────────
# PostgreSQL — Phase 11 (Persistent storage)
# ─────────────────────────────────────────────────────
# DATABASE_URL=postgresql://fxwolver:password@localhost:5432/fxwolver

# Secret key for JWT tokens (Phase 11)
# SECRET_KEY=change-this-to-a-long-random-string
